# --- LLM provider ---
# One of: openai, anthropic, none
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Agent behavior ---
# If true, the agent will only propose fixes, never apply them.
DRY_RUN=true

# Comma-separated list of remediation actions allowed to run.
# Supported: restart_container, scale_service, prune_logs, notify_only
ALLOWED_ACTIONS=notify_only,restart_container

# How often (seconds) to scan for anomalies in the buffer.
SCAN_INTERVAL_SECONDS=15

# Minimum seconds between two incidents for the same signature.
INCIDENT_COOLDOWN_SECONDS=300

# Optional Slack webhook for notifications.
SLACK_WEBHOOK_URL=
